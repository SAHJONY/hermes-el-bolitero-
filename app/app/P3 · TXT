                return (
                  <div style={{display:"grid",gap:8}}>
                    {stripe&&<a href={stripe} target="_blank" rel="noreferrer" className="btn primary" style={{display:"block",textAlign:"center",textDecoration:"none",...goldStyle}}>💳 Tarjeta · {p.precio}/mes</a>}
                    <div style={{display:"flex",gap:8}}>
