              {p.gold&&<div className="mono" style={{fontSize:10,letterSpacing:"0.2em",color:"#FFD978",marginBottom:6}}>★ EL MÁS PEDIDO</div>}
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"baseline"}}>
                <div className="disp" style={{fontWeight:800,fontSize:18,color:p.gold?"#FFD978":T.ink}}>{p.nombre}</div>
                <div><span className="disp" style={{fontWeight:800,fontSize:30,color:p.gold?T.mango:T.ink}}>{p.precio}</span><span style={{fontSize:12,color:T.dim}}>{p.per}</span></div>
