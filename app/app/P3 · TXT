                const stripe=payLinks?.[p.id];
                const pp=payLinks?.paypal? (payLinks.paypal.replace(/\/+$/,"")+"/"+p.monto+"USD") : null;
                const ca=payLinks?.cashtag? ("https://cash.app/$"+payLinks.cashtag.replace(/^\$/,"")+"/"+p.monto) : null;
