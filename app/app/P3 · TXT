        <div style={{display:"grid",gap:14}}>
          {PLANES.map(p=>(
            <div key={p.id} className="card" style={p.gold?{
              border:"1.5px solid #FFD978",
              background:`linear-gradient(180deg, rgba(255,184,56,.12), ${T.surface} 55%)`,
              boxShadow:"0 0 28px rgba(255,184,56,.18)"
